<resources>
    <!-- Compose draws the actual UI; this just sets the window background
         and status bar before Compose content appears. -->
    <style name="Theme.StreamCue" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
